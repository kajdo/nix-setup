AGENTS.md
# ignore hardwareinfo
./nixos/hardware-configuration.nix
./nixos/pi

# ignore pi-generated scratch artifacts (live plans/progress/sessions,
# subagent outputs) at any depth
**/.pi/
.pi-subagents/

# local-only diagnostics captures (GPU error dumps etc.) — persistent but untracked
logs/*
!logs/README.md

# local-only plan documents (kept locally, not version-controlled)
nixos/docs/plans/
